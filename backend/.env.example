# --- Database ---
DATABASE_URL=postgresql+psycopg2://dostt:dostt@localhost:5435/dostt_support
TEST_DATABASE_URL=postgresql+psycopg2://dostt:dostt@localhost:5435/dostt_support_test

# --- Admin dashboard auth ---
ADMIN_SESSION_SECRET=dev-only-change-me
ADMIN_SESSION_EXPIRE_HOURS=8
ADMIN_PASSWORD=dosttSupport@123

ENVIRONMENT=dev

# --- Gemini (via Vertex AI) ---
GOOGLE_CLOUD_LOCATION=global
GEMINI_VERTEX_CREDENTIALS_JSON=
GEMINI_MODEL=gemini-flash-latest
GEMINI_BILLING_FEATURE=dostt_support

# --- Mocked integrations ---
MOCK_MODE=true
SLACK_WEBHOOK_URL=https://hooks.slack.com/services/EXAMPLE/WEBHOOK/URL
SLACK_SUPPORT_CHANNEL=#dostt-support-alerts
SLACK_MOCK_MODE=true

# --- Redash (real production data) ---
# https://app.redash.io/<your-slug>, or your self-hosted instance's base URL
REDASH_BASE_URL=
REDASH_API_KEY=
REDASH_QUERY_RECENT_CALLS=20279
REDASH_QUERY_RECENT_RECHARGES=20290
REDASH_QUERY_RECENT_WITHDRAWALS=20311
REDASH_QUERY_SUPPORT_ISSUES=20282
REDASH_QUERY_ACCOUNT_ROLE=20310

# --- Rate limiting (see app/core/rate_limit.py) ---
RATE_LIMIT_CHAT_PER_SESSION_PER_MIN=20
RATE_LIMIT_CHAT_PER_IP_PER_MIN=60
RATE_LIMIT_SESSION_INIT_PER_IP_PER_MIN=30

# --- CORS ---
CORS_ORIGINS=http://localhost:5500,http://127.0.0.1:5500,http://localhost:8000
